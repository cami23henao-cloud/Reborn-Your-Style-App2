# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Optional API key for Google Maps Platform Javascript API & Places Autocomplete.
# If not provided, the app uses standard Google Maps Embed and Colombia geospatial directory.
VITE_GOOGLE_MAPS_API_KEY=""

# GOOGLE AUTHENTICATION (OAuth 2.0 / Google Identity Services)
# Configure these in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs:
# 1. Authorized JavaScript origins:
#    https://ais-dev-gcuffidqsfnsj6u4xbwrno-612995330455.us-east1.run.app
#    https://ais-pre-gcuffidqsfnsj6u4xbwrno-612995330455.us-east1.run.app
#    http://localhost:3000
# 2. Authorized redirect URIs:
#    https://ais-dev-gcuffidqsfnsj6u4xbwrno-612995330455.us-east1.run.app/auth/google/callback
#    https://ais-pre-gcuffidqsfnsj6u4xbwrno-612995330455.us-east1.run.app/auth/google/callback
#    http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
VITE_GOOGLE_CLIENT_ID=""

# SMTP EMAIL SERVICE (Configuración de Gmail SMTP para envío REAL de códigos OTP de recuperación)
# Para Gmail, utiliza tu dirección de correo y una Contraseña de Aplicación (no la contraseña usual de la cuenta).
# 1. En tu cuenta Google activa 'Verificación en dos pasos'.
# 2. En https://myaccount.google.com/apppasswords crea una contraseña de aplicación (16 caracteres).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu_correo@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="Reborn Your Style <tu_correo@gmail.com>"

# SMS SERVICE (Twilio REST API Integration for real recovery SMS codes)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# WHATSAPP SERVICE (Meta Business Cloud API Integration for real recovery WhatsApp codes)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
